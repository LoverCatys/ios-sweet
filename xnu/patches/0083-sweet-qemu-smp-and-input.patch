--- /dev/null
+++ b/bsd/dev/sweet_vinput.c
@@ -0,0 +1,89 @@
+/*
+ * SWEET QEMU shared-memory touch & button input bridge.
+ *
+ * Maps a 4 KiB ring buffer at physical 0x9d700000 (immediately after the
+ * framebuffer at 0x9c000000 + 0x1700000). The host QEMU viewer writes touch
+ * and button events directly into shared guest RAM; this thread forwards them
+ * to SweetHID (sweet_hid_touch / sweet_hid_key).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_hid_key(int key, int down);
+void sweet_vinput_init(void);
+
+#define VINPUT_PA       0x9d700000ull
+#define VINPUT_MAGIC    0x56494E50u /* "VINP" */
+#define VINPUT_RING_SZ  64u
+
+struct sweet_vinput_ev {
+	uint32_t type; /* 1 = touch (finger, down, x, y), 2 = key (key, down) */
+	int32_t a;
+	int32_t b;
+	int32_t c;
+	int32_t d;
+};
+
+struct sweet_vinput_ring {
+	uint32_t magic;
+	uint32_t wr_idx;
+	uint32_t rd_idx;
+	uint32_t pad;
+	struct sweet_vinput_ev ev[VINPUT_RING_SZ];
+};
+
+static volatile struct sweet_vinput_ring *vinput_ring;
+static int vinput_chan;
+static bool vinput_started;
+
+static void
+sweet_vinput_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		if (vinput_ring && vinput_ring->magic == VINPUT_MAGIC) {
+			uint32_t rd = vinput_ring->rd_idx;
+			uint32_t wr_i = vinput_ring->wr_idx;
+			__builtin_arm_dmb(0xf);
+			while (rd != wr_i) {
+				struct sweet_vinput_ev ev = vinput_ring->ev[rd % VINPUT_RING_SZ];
+				rd++;
+				if (ev.type == 1) {
+					sweet_hid_touch(ev.a, ev.b, ev.c, ev.d);
+				} else if (ev.type == 2) {
+					sweet_hid_key(ev.a, ev.b);
+				}
+			}
+			__builtin_arm_dmb(0xf);
+			vinput_ring->rd_idx = rd;
+		}
+		(void)tsleep(&vinput_chan, PZERO, "vinput", 1);
+	}
+}
+
+void
+sweet_vinput_init(void)
+{
+	if (vinput_started) {
+		return;
+	}
+	vm_offset_t va = ml_io_map(VINPUT_PA, 4096);
+	if (!va) {
+		printf("SWEET VINPUT: failed to map 0x%llx\n", VINPUT_PA);
+		return;
+	}
+	vinput_ring = (volatile struct sweet_vinput_ring *)va;
+	thread_t th;
+	if (kernel_thread_start(sweet_vinput_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+		vinput_started = true;
+		printf("SWEET VINPUT: shared-memory touch/key bridge ready at 0x%llx\n", VINPUT_PA);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
