+/*
+ * SWEET QEMU virtio-mmio (v2 / Virtio 1.0) block root device.
+ *
+ * Scans QEMU virt's 32 virtio-mmio slots (0x0a000000..0x0a003e00, stride 0x200)
+ * for a modern virtio-blk device (Magic=0x74726976, Version=2, DeviceID=2) and
+ * exposes the whole disk as /dev/vblk0 (/dev/rvblk0) for rd=vblk0.
+ * Polled I/O through a single 1 MiB contiguous bounce buffer under a mutex.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define VMMIO_BASE              0x0a000000ull
+#define VMMIO_STRIDE            0x200u
+#define VMMIO_SLOTS             32u
+#define VMMIO_SIZE              (VMMIO_SLOTS * VMMIO_STRIDE)
+
+#define VMMIO_MAGIC             0x000u
+#define VMMIO_VERSION           0x004u
+#define VMMIO_DEVICE_ID         0x008u
+#define VMMIO_DEV_FEATURES      0x010u
+#define VMMIO_DEV_FEATURES_SEL  0x014u
+#define VMMIO_DRV_FEATURES      0x020u
+#define VMMIO_DRV_FEATURES_SEL  0x024u
+#define VMMIO_QUEUE_SEL         0x030u
+#define VMMIO_QUEUE_NUM_MAX     0x034u
+#define VMMIO_QUEUE_NUM         0x038u
+#define VMMIO_QUEUE_READY       0x044u
+#define VMMIO_QUEUE_NOTIFY      0x050u
+#define VMMIO_INT_STATUS        0x060u
+#define VMMIO_INT_ACK           0x064u
+#define VMMIO_STATUS            0x070u
+#define VMMIO_QUEUE_DESC_LOW    0x080u
+#define VMMIO_QUEUE_DESC_HIGH   0x084u
+#define VMMIO_QUEUE_DRV_LOW     0x090u
+#define VMMIO_QUEUE_DRV_HIGH    0x094u
+#define VMMIO_QUEUE_DEV_LOW     0x0a0u
+#define VMMIO_QUEUE_DEV_HIGH    0x0a4u
+#define VMMIO_CONFIG            0x100u
+
+#define VIRTIO_MAGIC_VAL        0x74726976u
+#define VIRTIO_DEV_BLK          2u
+
+#define STATUS_ACK              1u
+#define STATUS_DRIVER           2u
+#define STATUS_DRIVER_OK        4u
+#define STATUS_FEATURES_OK      8u
+
+#define VIRTQ_DESC_F_NEXT       1u
+#define VIRTQ_DESC_F_WRITE      2u
+
+#define VIRTIO_BLK_T_IN         0u
+#define VIRTIO_BLK_T_OUT        1u
+#define VIRTIO_BLK_T_FLUSH      4u
+
+#define QSIZE                   16u
+#define SECTOR_SIZE             512u
+#define BOUNCE_SIZE             (1u << 20)
+#define CMD_TIMEOUT_NS          (10ull * NSEC_PER_SEC)
+
+#define DMA_DESC                0x0000u
+#define DMA_AVAIL               0x1000u
+#define DMA_USED                0x2000u
+#define DMA_REQ                 0x3000u
+#define DMA_STATUS              0x3040u
+#define DMA_BOUNCE              0x4000u
+#define DMA_SIZE                (DMA_BOUNCE + BOUNCE_SIZE)
+
+struct virtq_desc {
+	uint64_t addr;
+	uint32_t len;
+	uint16_t flags;
+	uint16_t next;
+};
+
+struct virtq_avail {
+	uint16_t flags;
+	uint16_t idx;
+	uint16_t ring[QSIZE];
+	uint16_t used_event;
+};
+
+struct virtq_used_elem {
+	uint32_t id;
+	uint32_t len;
+};
+
+struct virtq_used {
+	uint16_t flags;
+	uint16_t idx;
+	struct virtq_used_elem ring[QSIZE];
+	uint16_t avail_event;
+};
+
+struct virtio_blk_req {
+	uint32_t type;
+	uint32_t reserved;
+	uint64_t sector;
+};
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;
+	uint64_t dma_pa;
+	uint64_t nsectors;
+	uint32_t secsize;
+	uint16_t last_used;
+	bool writable;
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} vb;
+
+static LCK_GRP_DECLARE(sweet_vblk_grp, "sweet_vblk");
+static LCK_MTX_DECLARE(sweet_vblk_lock, &sweet_vblk_grp);
+
+static inline uint32_t
+vb_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(vb.regs + off);
+}
+
+static inline void
+vb_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(vb.regs + off) = v;
+}
+
+static int
+vblk_submit(uint32_t type, uint64_t sector, uint32_t len)
+{
+	volatile struct virtq_desc *desc = (volatile struct virtq_desc *)(vb.dma + DMA_DESC);
+	volatile struct virtq_avail *avail = (volatile struct virtq_avail *)(vb.dma + DMA_AVAIL);
+	volatile struct virtq_used *used = (volatile struct virtq_used *)(vb.dma + DMA_USED);
+	volatile struct virtio_blk_req *req = (volatile struct virtio_blk_req *)(vb.dma + DMA_REQ);
+	volatile uint8_t *status = (volatile uint8_t *)(vb.dma + DMA_STATUS);
+
+	req->type = type;
+	req->reserved = 0;
+	req->sector = sector;
+	*status = 0xff;
+
+	desc[0].addr = vb.dma_pa + DMA_REQ;
+	desc[0].len = sizeof(struct virtio_blk_req);
+	desc[0].flags = VIRTQ_DESC_F_NEXT;
+	desc[0].next = len ? 1 : 2;
+
+	if (len) {
+		desc[1].addr = vb.dma_pa + DMA_BOUNCE;
+		desc[1].len = len;
+		desc[1].flags = (uint16_t)(VIRTQ_DESC_F_NEXT | (type == VIRTIO_BLK_T_IN ? VIRTQ_DESC_F_WRITE : 0));
+		desc[1].next = 2;
+	}
+
+	desc[2].addr = vb.dma_pa + DMA_STATUS;
+	desc[2].len = 1;
+	desc[2].flags = VIRTQ_DESC_F_WRITE;
+	desc[2].next = 0;
+
+	uint16_t aidx = avail->idx;
+	avail->ring[aidx % QSIZE] = 0;
+	__builtin_arm_dsb(0xf);
+	avail->idx = (uint16_t)(aidx + 1);
+	__builtin_arm_dsb(0xf);
+
+	vb_wr(VMMIO_QUEUE_NOTIFY, 0);
+
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (used->idx == vb.last_used) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET VBLK: req type=%u sector=0x%llx len=%u timed out\n",
+			    type, sector, len);
+			return ETIMEDOUT;
+		}
+		__builtin_arm_dsb(0xf);
+	}
+	vb.last_used = used->idx;
+	uint32_t isr = vb_rd(VMMIO_INT_STATUS);
+	if (isr) {
+		vb_wr(VMMIO_INT_ACK, isr);
+	}
+	__builtin_arm_dsb(0xf);
+
+	if (*status != 0) {
+		printf("SWEET VBLK: req type=%u sector=0x%llx status=%u\n",
+		    type, sector, *status);
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+sweet_vblk_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!vb.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !vb.writable) ? EROFS : 0;
+}
+
+static int
+sweet_vblk_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_vblk_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * vb.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t disk_bytes = vb.nsectors * SECTOR_SIZE;
+	bool rd = (buf_flags(bp) & B_READ) != 0;
+
+	buf_setresid(bp, count);
+	if (!rd && !vb.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > disk_bytes || count > disk_bytes - off || (off % SECTOR_SIZE) || (count % SECTOR_SIZE)) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_vblk_lock);
+	void *bounce = (void *)(vb.dma + DMA_BOUNCE);
+	for (uint32_t done = 0; done < count;) {
+		uint32_t chunk = MIN(count - done, BOUNCE_SIZE);
+		uint64_t sector = (off + done) / SECTOR_SIZE;
+		if (rd) {
+			error = vblk_submit(VIRTIO_BLK_T_IN, sector, chunk);
+			if (!error) {
+				memcpy(vaddr + done, bounce, chunk);
+			}
+		} else {
+			memcpy(bounce, vaddr + done, chunk);
+			error = vblk_submit(VIRTIO_BLK_T_OUT, sector, chunk);
+		}
+		if (error) {
+			break;
+		}
+		done += chunk;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_vblk_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_vblk_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = vb.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < SECTOR_SIZE || *f > 4096u || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		vb.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = 4096u;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = (vb.nsectors * SECTOR_SIZE) / vb.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = vb.writable ? 1u : 0u;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!vb.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&sweet_vblk_lock);
+		int error = vblk_submit(VIRTIO_BLK_T_FLUSH, 0, 0);
+		lck_mtx_unlock(&sweet_vblk_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / vb.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = vb.writable ? (BOUNCE_SIZE / vb.secsize) : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_vblk_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_vblk_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_vblk_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_vblk_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_vblk_psize(__unused dev_t dev)
+{
+	return vb.ready ? (int)MIN((vb.nsectors * SECTOR_SIZE) / vb.secsize, (uint64_t)INT_MAX) : -1;
+}
+
+static int
+sweet_vblk_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_vblk_strategy, NULL, dev, B_READ, minphys, uio, (int)vb.secsize);
+}
+
+static int
+sweet_vblk_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!vb.writable) {
+		return EROFS;
+	}
+	return physio(sweet_vblk_strategy, NULL, dev, B_WRITE, minphys, uio, (int)vb.secsize);
+}
+
+static const struct bdevsw sweet_vblk_bdevsw = {
+	.d_open     = sweet_vblk_open,
+	.d_close    = sweet_vblk_close,
+	.d_strategy = sweet_vblk_strategy,
+	.d_ioctl    = sweet_vblk_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_vblk_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_vblk_cdevsw = {
+	.d_open       = sweet_vblk_open,
+	.d_close      = sweet_vblk_close,
+	.d_read       = sweet_vblk_read,
+	.d_write      = sweet_vblk_write,
+	.d_ioctl      = sweet_vblk_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_vblk_init(void)
+{
+	vm_offset_t base = ml_io_map(VMMIO_BASE, VMMIO_SIZE);
+	if (!base) {
+		return ENOMEM;
+	}
+	bool found = false;
+	for (uint32_t slot = 0; slot < VMMIO_SLOTS; slot++) {
+		vm_offset_t r = base + slot * VMMIO_STRIDE;
+		uint32_t magic = *(volatile uint32_t *)(r + VMMIO_MAGIC);
+		uint32_t ver = *(volatile uint32_t *)(r + VMMIO_VERSION);
+		uint32_t devid = *(volatile uint32_t *)(r + VMMIO_DEVICE_ID);
+		if (magic == VIRTIO_MAGIC_VAL && ver == 2 && devid == VIRTIO_DEV_BLK) {
+			vb.regs = r;
+			found = true;
+			printf("SWEET VBLK: found virtio-mmio v2 blk at slot %u (0x%llx)\n",
+			    slot, VMMIO_BASE + slot * VMMIO_STRIDE);
+			break;
+		}
+	}
+	if (!found) {
+		printf("SWEET VBLK: no virtio-mmio v2 block device found\n");
+		return ENXIO;
+	}
+
+	if (kmem_alloc_contig(kernel_map, &vb.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET VBLK: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)vb.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	vb.dma_pa = ptoa_64(pn);
+
+	/* Virtio 1.0 MMIO initialization. */
+	vb_wr(VMMIO_STATUS, 0);
+	__builtin_arm_dsb(0xf);
+	vb_wr(VMMIO_STATUS, STATUS_ACK);
+	vb_wr(VMMIO_STATUS, STATUS_ACK | STATUS_DRIVER);
+
+	vb_wr(VMMIO_DRV_FEATURES_SEL, 0);
+	vb_wr(VMMIO_DRV_FEATURES, 0);
+	vb_wr(VMMIO_DRV_FEATURES_SEL, 1);
+	vb_wr(VMMIO_DRV_FEATURES, 1u); /* VIRTIO_F_VERSION_1 */
+
+	vb_wr(VMMIO_STATUS, STATUS_ACK | STATUS_DRIVER | STATUS_FEATURES_OK);
+	if (!(vb_rd(VMMIO_STATUS) & STATUS_FEATURES_OK)) {
+		printf("SWEET VBLK: device rejected features\n");
+		return EIO;
+	}
+
+	vb_wr(VMMIO_QUEUE_SEL, 0);
+	uint32_t qmax = vb_rd(VMMIO_QUEUE_NUM_MAX);
+	if (qmax < QSIZE) {
+		printf("SWEET VBLK: queue max %u < %u\n", qmax, QSIZE);
+		return EIO;
+	}
+	vb_wr(VMMIO_QUEUE_NUM, QSIZE);
+	uint64_t desc_pa = vb.dma_pa + DMA_DESC;
+	uint64_t avail_pa = vb.dma_pa + DMA_AVAIL;
+	uint64_t used_pa = vb.dma_pa + DMA_USED;
+	vb_wr(VMMIO_QUEUE_DESC_LOW, (uint32_t)desc_pa);
+	vb_wr(VMMIO_QUEUE_DESC_HIGH, (uint32_t)(desc_pa >> 32));
+	vb_wr(VMMIO_QUEUE_DRV_LOW, (uint32_t)avail_pa);
+	vb_wr(VMMIO_QUEUE_DRV_HIGH, (uint32_t)(avail_pa >> 32));
+	vb_wr(VMMIO_QUEUE_DEV_LOW, (uint32_t)used_pa);
+	vb_wr(VMMIO_QUEUE_DEV_HIGH, (uint32_t)(used_pa >> 32));
+	vb_wr(VMMIO_QUEUE_READY, 1);
+	__builtin_arm_dsb(0xf);
+	vb_wr(VMMIO_STATUS, STATUS_ACK | STATUS_DRIVER | STATUS_FEATURES_OK | STATUS_DRIVER_OK);
+
+	uint64_t cap_lo = vb_rd(VMMIO_CONFIG);
+	uint64_t cap_hi = vb_rd(VMMIO_CONFIG + 4);
+	vb.nsectors = cap_lo | (cap_hi << 32);
+	if (!vb.nsectors) {
+		printf("SWEET VBLK: zero capacity\n");
+		return ENXIO;
+	}
+
+	uint32_t ro = 0;
+	PE_parse_boot_argn("vblkro", &ro, sizeof(ro));
+	vb.writable = (ro == 0);
+	vb.secsize = SECTOR_SIZE;
+	vb.last_used = 0;
+
+	vb.bmajor = bdevsw_add(-1, &sweet_vblk_bdevsw);
+	if (vb.bmajor < 0) {
+		return ENXIO;
+	}
+	vb.cmajor = cdevsw_add_with_bdev(-1, &sweet_vblk_cdevsw, vb.bmajor);
+	if (vb.cmajor < 0) {
+		return ENXIO;
+	}
+	vb.bdev = makedev(vb.bmajor, 0);
+	devfs_make_node(vb.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "vblk0");
+	devfs_make_node(makedev(vb.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rvblk0");
+	vb.ready = true;
+	printf("SWEET VBLK: ready, %llu MiB (%llu sectors), %s\n",
+	    (vb.nsectors * SECTOR_SIZE) >> 20, vb.nsectors,
+	    vb.writable ? "read-write" : "read-only");
+	return 0;
+}
+
+int sweet_vblk_rootdev(dev_t *dev);
+
+int
+sweet_vblk_rootdev(dev_t *dev)
+{
+	if (!vb.ready) {
+		int error = sweet_vblk_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = vb.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
